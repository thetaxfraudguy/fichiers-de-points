# Startup timing; read with `zsh-startup-report`
zmodload zsh/datetime
typeset -g _zrc_t0=$EPOCHREALTIME
typeset -ga _zrc_marks=()
_zrc_mark() { _zrc_marks+=( "$1" "$EPOCHREALTIME" ) }

# Cache the output of slow init commands, regenerating when the binary changes.
typeset -g _zrc_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $_zrc_cache ]] || mkdir -p $_zrc_cache
_zrc_eval_cached() {
  local name=$1 bin=$2; shift 2
  local f=$_zrc_cache/$name.zsh
  [[ -n $bin && -x $bin ]] || return 0
  if [[ ! -s $f || $bin -nt $f ]]; then
    "$@" >| $f 2>/dev/null || { rm -f $f; return 1 }
  fi
  source $f
}

_zrc_brew=/opt/homebrew/bin/brew
[[ -x $_zrc_brew ]] || _zrc_brew=/usr/local/bin/brew
_zrc_eval_cached brew-shellenv $_zrc_brew $_zrc_brew shellenv
_zrc_mark brew

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
export EDITOR="vim"
export VISUAL="vim"
export LESS="-F -X -R"

export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE=$HOME/.zsh_history
export HIST_STAMPS="yyyy-mm-dd"

bindkey '\e[A' history-search-backward
bindkey '\e[B' history-search-forward

setopt HIST_SAVE_NO_DUPS

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

alias ls="ls -A --color=auto"

autoload -Uz bashcompinit && bashcompinit
autoload -Uz compinit
# Full rebuild (with security audit) at most once a day; otherwise trust the dump.
if [[ -n $HOME/.zcompdump(#qNmh-24) ]]; then
  compinit -C -d $HOME/.zcompdump
else
  compinit -d $HOME/.zcompdump
  [[ -s $HOME/.zcompdump ]] && zcompile -R -- $HOME/.zcompdump 2>/dev/null
fi
_zrc_mark compinit

#AWS
export AWS_PAGER=

avs () { profile=$1; shift; aws-vault exec $profile -- "$@"; }
s3cat() { aws s3 cp "s3://$1" -; }

complete -C aws_completer aws

# Chezmoi
alias chd="chezmoi diff"
alias cha="chezmoi apply"
alias chc="chezmoi cd"

# Docker
alias d="docker"
alias dc="docker-compose"
alias dcu="docker-compose up"
alias dcud="docker-compose up -d"
alias dcd="docker-compose down"

dlogin () { docker exec -it $1 /bin/sh; }
drun () { docker run -it --rm $1 /bin/sh; }

# Git
export GPG_TTY=$TTY

alias g="git"
alias gco="git checkout"
alias gcob="git checkout -b"
alias gl="git log"
alias gpl="git pull"
alias gps="git push"
alias gcam="git commit -am"

gdl () { git fetch -p && for branch in $(git for-each-ref --format '%(refname) %(upstream:track)' refs/heads | awk '$2 == "[gone]" {sub("refs/heads/", "", $1); print $1}'); do git branch -D $branch; done; }

# FZF
. $HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh
. $HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh
_zrc_mark fzf

# Golang
export GOPATH="$HOME/Projects/Go"
export PATH="$GOPATH/bin:$GOROOT/bin:$PATH"

# Kubernetes
nspace () { kubectl config set-context --current --namespace=$1; }
_zrc_eval_cached kubectl-completion ${commands[kubectl]} kubectl completion zsh
alias kc="kubecolor"
compdef kubecolor=kubectl
_zrc_mark kubectl

# Mise-en-place
_zrc_eval_cached mise-activate $HOMEBREW_PREFIX/bin/mise $HOMEBREW_PREFIX/bin/mise activate zsh
_zrc_mark mise

#Postgres
export PATH="$HOMEBREW_PREFIX/opt/libpq/bin:$PATH"

# OpenTofu
alias tf="tofu"
alias tfi="tofu init"
alias tfv="tofu validate"
alias tff="tofu fmt -recursive"
alias tfp="tofu plan"
alias tfa="tofu apply"
alias tfaa="tofu apply -auto-approve"

# Terraform (docs)
alias tfdoc="terraform-docs markdown table --output-file README.md --output-mode inject ."

# Starship
_zrc_eval_cached starship-init ${commands[starship]} starship init zsh
_zrc_mark starship

# Secret Secrets
test -s "$HOME/.secret_secrets" && . "$HOME/.secret_secrets"
_zrc_mark secrets

[[ -s "$HOME/Projects/Python/incidentbot/.uv/bin/env" ]] && . "$HOME/Projects/Python/incidentbot/.uv/bin/env"
_zrc_mark uv

_zrc_flush_timings() {
  local dir=${XDG_STATE_HOME:-$HOME/.local/state}
  [[ -d $dir ]] || mkdir -p $dir
  local -a out
  local i prev=$_zrc_t0
  for (( i=1; i <= $#_zrc_marks; i+=2 )); do
    out+=( "$(printf '%s=%.0f' $_zrc_marks[i] $(( (_zrc_marks[i+1] - prev) * 1000 )))" )
    prev=$_zrc_marks[i+1]
  done
  local ts; strftime -s ts '%Y-%m-%dT%H:%M:%S%z' $EPOCHSECONDS
  printf '%s total=%.0f %s\n' \
    "$ts" \
    $(( (EPOCHREALTIME - _zrc_t0) * 1000 )) \
    "${(j: :)out}" >> $dir/zsh-startup.log
}
_zrc_flush_timings
